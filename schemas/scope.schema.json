      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "by_account": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Account",
          "type": "object"
        },
        "by_confidence": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Confidence",
          "type": "object"
        },
        "by_region": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Region",
          "type": "object"
        },
        "events_in_scope": {
          "title": "Events In Scope",
          "type": "integer"
        },
        "failed_calls": {
          "title": "Failed Calls",
          "type": "integer"
        },
        "first_event_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Event Time"
        },
        "last_event_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Event Time"
        }
      },
      "required": [
        "events_in_scope",
        "by_confidence",
        "by_account",
        "by_region",
        "failed_calls",
        "first_event_time",
        "last_event_time"
      ],
      "title": "Summary",
      "type": "object"
    },
    "UserIdentity": {
      "additionalProperties": false,
