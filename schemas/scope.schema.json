  "$id": "https://controlzee.invalid/schemas/scope-0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/ScopedEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "inputs": {
      "$ref": "#/$defs/InputsSummary"
    },
    "near_miss_summary": {
      "$ref": "#/$defs/NearMissSummary"
    },
    "near_misses": {
      "items": {
        "$ref": "#/$defs/NearMiss"
      },
      "title": "Near Misses",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_sha256": {
      "default": "",
      "title": "Scope Sha256",
      "type": "string"
    },
    "seeds": {
      "$ref": "#/$defs/SeedInfo"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "tool": {
      "additionalProperties": true,
      "title": "Tool",
      "type": "object"
    }
  },
  "required": [
    "tool",
    "inputs",
    "seeds",
    "summary",
    "events",
    "near_misses",
    "near_miss_summary"
  ],
  "title": "Scope",
  "type": "object"
}
