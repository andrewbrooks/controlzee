    "Window": {
      "additionalProperties": false,
      "description": "Inclusive time window in UTC, as ISO-8601 strings ending in Z.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "title": "Window",
      "type": "object"
