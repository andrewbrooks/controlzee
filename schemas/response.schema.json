{
  "$defs": {
    "Caller": {
      "additionalProperties": false,
      "description": "Who the supplied credentials are.",
      "properties": {
        "account": {
          "title": "Account",
          "type": "string"
        },
        "arn": {
          "title": "Arn",
          "type": "string"
        },
        "principal_arn": {
          "title": "Principal Arn",
          "type": "string"
        }
      },
      "required": [
        "account",
        "arn",
        "principal_arn"
      ],
      "title": "Caller",
      "type": "object"
    },
    "ExecutedStep": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Args",
          "type": "object"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "At"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Region"
        },
        "result": {
          "enum": [
            "done",
            "already done",
            "failed",
            "not run"
          ],
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "op",
        "args",
        "region",
        "result",
        "detail",
        "at"
      ],
      "title": "ExecutedStep",
      "type": "object"
    }
