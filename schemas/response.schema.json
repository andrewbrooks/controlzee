  "$id": "https://controlzee.invalid/schemas/response-0.2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "caller": {
      "$ref": "#/$defs/Caller"
    },
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "dryrun_sha256": {
      "title": "Dryrun Sha256",
      "type": "string"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "response_sha256": {
      "default": "",
      "title": "Response Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/ExecutedStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "tool": {
      "additionalProperties": true,
      "title": "Tool",
      "type": "object"
    }
