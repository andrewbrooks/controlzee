{
  "$defs": {
    "ActivityCheck": {
      "additionalProperties": false,
      "description": "What the check for activity after the scope looked at, whatever it found. It only ever warns.",
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "events_read": {
          "title": "Events Read",
          "type": "integer"
        },
        "failed_regions": {
          "items": {
            "type": "string"
          },
          "title": "Failed Regions",
          "type": "array"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        },
        "since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Since"
        },
        "status": {
          "enum": [
            "new activity",
            "no new activity",
            "could not run",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "total_found": {
          "title": "Total Found",
          "type": "integer"
        },
        "unread_regions": {
          "items": {
            "type": "string"
          },
          "title": "Unread Regions",
          "type": "array"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Until"
        }
      },
      "required": [
        "status",
        "since",
        "until",
        "regions",
        "failed_regions",
        "unread_regions",
        "events_read",
        "total_found",
        "complete"
      ],
      "title": "ActivityCheck",
      "type": "object"
    },
    "Caller": {
      "additionalProperties": false,
      "description": "Who the supplied credentials are.",
      "properties": {
        "account": {
          "title": "Account",
          "type": "string"
        },
        "arn": {
          "title": "Arn",
          "type": "string"
        },
        "principal_arn": {
          "title": "Principal Arn",
          "type": "string"
        }
      },
      "required": [
        "account",
        "arn",
        "principal_arn"
      ],
      "title": "Caller",
      "type": "object"
    },
    "DryRunStep": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "already_done": {
          "title": "Already Done",
          "type": "boolean"
        },
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Args",
          "type": "object"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/PermissionCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "identity": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Identity",
          "type": "object"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "problem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Problem"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Region"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "phase",
        "title",
        "op",
        "args",
        "region",
        "description",
        "state",
        "identity",
        "already_done",
        "checks",
        "ok",
        "problem"
      ],
      "title": "DryRunStep",
      "type": "object"
    },
    "NewActivity": {
      "additionalProperties": false,
      "description": "A call made, after the scope was built, by an identity the scope says is the attacker's.",
      "properties": {
        "event": {
          "title": "Event",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "time": {
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "time",
        "identity",
        "event",
        "region",
        "event_id"
      ],
      "title": "NewActivity",
      "type": "object"
    },
    "NotSelected": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "title",
        "reason"
      ],
      "title": "NotSelected",
      "type": "object"
    },
    "PermissionCheck": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "action",
        "resource",
        "decision"
      ],
      "title": "PermissionCheck",
      "type": "object"
    }
  },
  "$id": "https://controlzee.invalid/schemas/dryrun-0.3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity_check": {
      "$ref": "#/$defs/ActivityCheck"
    },
    "allow_disruptive": {
      "title": "Allow Disruptive",
      "type": "boolean"
    },
    "caller": {
      "$ref": "#/$defs/Caller"
    },
    "checked_at": {
      "title": "Checked At",
      "type": "string"
    },
    "chosen_steps": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Chosen Steps"
    },
    "dryrun_sha256": {
      "default": "",
      "title": "Dryrun Sha256",
      "type": "string"
    },
    "home_region": {
      "title": "Home Region",
      "type": "string"
    },
    "new_activity": {
      "items": {
        "$ref": "#/$defs/NewActivity"
      },
      "title": "New Activity",
      "type": "array"
    },
    "not_selected": {
      "items": {
        "$ref": "#/$defs/NotSelected"
      },
      "title": "Not Selected",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "plan_sha256": {
      "title": "Plan Sha256",
      "type": "string"
    },
    "problems": {
      "items": {
        "type": "string"
      },
      "title": "Problems",
      "type": "array"
    },
    "schema_version": {
      "default": "0.3",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_sha256": {
      "title": "Scope Sha256",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/DryRunStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "tool": {
      "additionalProperties": true,
      "title": "Tool",
      "type": "object"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "tool",
    "scope_sha256",
    "plan_sha256",
    "caller",
    "home_region",
    "checked_at",
    "allow_disruptive",
    "chosen_steps",
    "steps",
    "not_selected",
    "activity_check",
    "new_activity",
    "problems",
    "passed"
  ],
  "title": "DryRun",
  "type": "object"
}
